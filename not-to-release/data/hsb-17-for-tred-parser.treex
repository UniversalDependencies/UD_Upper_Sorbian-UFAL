      <zones>
        <zone language="hsb">
          <sentence>Najebać toho, někajke substancy so njederje měšeja z wodu, inkluziwnje wolijow a hydrofobnych substancow.</sentence>
          <trees>
            <a_tree id="p175s2/hsb">
